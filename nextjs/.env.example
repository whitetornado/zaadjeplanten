# Kopieer dit bestand naar .env.local en vul de echte waarden in
# (staan in Supabase: Settings → API)

NEXT_PUBLIC_SUPABASE_URL=https://jouw-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=jouw-anon-key
SUPABASE_SERVICE_ROLE_KEY=jouw-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Wachtwoord voor /tuin (intern overzicht). Zet dezelfde waarde in Vercel.
TUIN_WACHTWOORD=kies-een-sterk-wachtwoord

# Testversnelling: 1 uur wordt 1 minuut. Nooit aanzetten op de live site.
# TEMPO=snel
